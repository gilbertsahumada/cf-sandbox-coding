{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-sandbox-coding",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "MODEL_BASE_URL": "https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1",
    "MODEL_ID": "qwen3.7-flash",
    "MODEL_API": "chat-completions",
    "MODEL_CONTEXT_WINDOW": "32768",
    "MODEL_MAX_TOKENS": "4096"
  },
  "secrets": {
    "required": [
      "MODEL_API_KEY",
      "RUNNER_API_TOKEN"
    ]
  },
  "containers": [
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "agent": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AgentSandbox",
        "name": "SANDBOX"
      },
      {
        "class_name": "GitHubConnection",
        "name": "GITHUB"
      }
    ]
  },
  "exports": {
    "AgentSandbox": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "GitHubConnection": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "account_id": "bc8d4adf4860284fda426b24e7377bc2",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
