{
  "name": "cf-sandbox-coding",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "task": "node scripts/run-task.mjs",
    "configure": "node scripts/configure.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:sse": "node scripts/verify-sse.mjs",
    "build": "vite build",
    "dev:ui": "vite",
    "preview:editor": "npm run build && node scripts/preview-editor.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.7",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "wrangler": "4.151.2"
  }
}
